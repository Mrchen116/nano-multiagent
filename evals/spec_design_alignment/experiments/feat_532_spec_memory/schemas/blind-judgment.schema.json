{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formal_eligible", "judge_id", "assessments", "critical_error", "summary"],
  "properties": {
    "formal_eligible": {"type": "boolean", "const": false},
    "judge_id": {"type": "string"},
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projection_id", "criteria", "critical_error"],
        "properties": {
          "projection_id": {"type": "string", "enum": ["P1", "P2"]},
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "rating", "rationale"],
              "properties": {
                "criterion_id": {"type": "string"},
                "rating": {"type": "string", "enum": ["met", "partial", "missed"]},
                "rationale": {"type": "string"}
              }
            }
          },
          "critical_error": {"type": "boolean"}
        }
      }
    },
    "critical_error": {"type": "boolean"},
    "summary": {"type": "string"}
  }
}
