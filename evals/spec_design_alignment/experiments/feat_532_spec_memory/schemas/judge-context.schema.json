{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "case_id",
    "formal_eligible",
    "status",
    "critical_error_policy",
    "criteria"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "H02"},
    "formal_eligible": {"const": false},
    "status": {"const": "provisional_unconfirmed"},
    "critical_error_policy": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "materiality", "source_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^J[0-9]{2}$"},
          "requirement": {"type": "string", "minLength": 1},
          "materiality": {"enum": ["critical", "high", "normal"]},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
