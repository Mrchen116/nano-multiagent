{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formal_eligible", "events"],
  "properties": {
    "formal_eligible": {"type": "boolean", "const": false},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "state", "affected_behavior", "rationale"],
        "properties": {
          "memory_id": {"type": "string"},
          "state": {"type": "string", "enum": ["loaded", "used", "rejected", "overridden"]},
          "affected_behavior": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
