{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "case_id",
    "formal_eligible",
    "status",
    "interaction_guidance",
    "atoms"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "H02"},
    "formal_eligible": {"const": false},
    "status": {"const": "provisional_unconfirmed"},
    "interaction_guidance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content",
          "authority",
          "source_refs",
          "evidence_clock",
          "disclosure_class"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^O[0-9]{2}$"},
          "content": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_clock": {"type": "string", "minLength": 1},
          "disclosure_class": {
            "enum": [
              "public_restate",
              "owner_only_answerable",
              "product_judgment",
              "repo_retrievable_redirect",
              "design_out_of_scope",
              "known_unknown",
              "delegated"
            ]
          }
        }
      }
    }
  }
}
