{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "case_id",
    "formal_eligible",
    "repetitions",
    "base_recipe",
    "public_brief",
    "case_lineage_exclusions",
    "global_exclusions",
    "projection_seed",
    "model",
    "reasoning_effort",
    "max_candidate_turns",
    "allowed_conclusions"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "pilot_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "H02"},
    "formal_eligible": {"const": false},
    "repetitions": {"const": 1},
    "base_recipe": {"type": "string", "minLength": 1},
    "public_brief": {"type": "string", "minLength": 1},
    "case_lineage_exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "global_exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "projection_seed": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
    "max_candidate_turns": {"type": "integer", "minimum": 1},
    "allowed_conclusions": {
      "const": ["infrastructure_pass", "infrastructure_fail"]
    }
  }
}
