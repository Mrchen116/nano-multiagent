{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "formal_eligible",
    "cwd",
    "resolved_argv",
    "environment_policy",
    "readable_roots",
    "initial_visible_files",
    "final_visible_files",
    "input_envelope_sha256",
    "tools",
    "os_sandbox",
    "exit_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "formal_eligible": {"const": false},
    "cwd": {"const": "workspace"},
    "resolved_argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "environment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "home", "codex_home", "tmpdir"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "home": {"const": "role_runtime/home"},
        "codex_home": {"const": "role_runtime/codex-home"},
        "tmpdir": {"const": "role_runtime/tmp"}
      }
    },
    "readable_roots": {
      "const": ["role_runtime_except_credentials", "system_runtime", "workspace"]
    },
    "initial_visible_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "final_visible_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "input_envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "workspace_write", "network", "command_execution_observed"],
      "properties": {
        "shell": {"const": true},
        "workspace_write": {"type": "boolean"},
        "network": {"const": false},
        "command_execution_observed": {"type": "boolean"}
      }
    },
    "os_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "profile_sha256",
        "canary_read_blocked",
        "unrelated_read_blocked",
        "credential_read_blocked",
        "nested_codex_blocked",
        "tool_network_blocked"
      ],
      "properties": {
        "mechanism": {"const": "macos_sandbox_exec_seatbelt"},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canary_read_blocked": {"const": true},
        "unrelated_read_blocked": {"const": true},
        "credential_read_blocked": {"const": true},
        "nested_codex_blocked": {"const": true},
        "tool_network_blocked": {"const": true}
      }
    },
    "exit_code": {"type": "integer"}
  }
}
