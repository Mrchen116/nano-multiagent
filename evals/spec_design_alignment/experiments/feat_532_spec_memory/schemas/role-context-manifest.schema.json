{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "role",
    "formal_eligible",
    "lifecycle",
    "cwd",
    "model",
    "reasoning_effort",
    "instructions_sha256",
    "input_envelope_sha256",
    "output_schema_sha256",
    "visible_files",
    "readable_roots",
    "execution",
    "skill_closure",
    "tools",
    "isolation",
    "forbidden_surfaces"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "role": {
      "enum": [
        "memory_builder",
        "candidate",
        "owner_simulator",
        "owner_run_auditor",
        "owner_batch_auditor",
        "burden_scorer",
        "blind_quality_judge",
        "loop_experimenter",
        "memory_trace"
      ]
    },
    "formal_eligible": {"const": false},
    "lifecycle": {"enum": ["ephemeral", "persistent"]},
    "cwd": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
    "instructions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visible_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "readable_roots": {
      "const": ["role_runtime", "system_runtime", "workspace"]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "resolved_argv", "environment_policy"],
      "properties": {
        "cwd": {"const": "workspace"},
        "resolved_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "environment_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys", "home", "codex_home", "tmpdir"],
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "home": {"const": "role_runtime/home"},
            "codex_home": {"const": "role_runtime/codex-home"},
            "tmpdir": {"const": "role_runtime/tmp"}
          }
        }
      }
    },
    "skill_closure": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "workspace_write", "network"],
      "properties": {
        "shell": {"const": true},
        "workspace_write": {"type": "boolean"},
        "network": {"const": false}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "codex_home", "ignore_user_config", "filesystem_read"],
      "properties": {
        "home": {"const": "temporary_isolated"},
        "codex_home": {"const": "temporary_isolated"},
        "ignore_user_config": {"const": true},
        "filesystem_read": {"const": "macos_sandbox_exec_seatbelt"}
      }
    },
    "forbidden_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
