{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formal_eligible", "run_id", "critical_error", "findings"],
  "properties": {
    "formal_eligible": {"type": "boolean", "const": false},
    "run_id": {"type": "string"},
    "critical_error": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "evidence", "context_refs"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "unsupported_material_judgment",
              "unsolicited_material_disclosure",
              "disclosure_class_violation",
              "internal_contradiction",
              "incorrect_context_refs"
            ]
          },
          "severity": {"type": "string", "enum": ["critical", "warning"]},
          "evidence": {"type": "string"},
          "context_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
