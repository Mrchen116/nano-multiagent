{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nano-multiagent.local/evaluation/schema/case.schema.json",
  "title": "Spec/design evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "stratum",
    "status",
    "origin",
    "brief_ref",
    "artifact_contract",
    "terminal_mode",
    "source_root_ids",
    "clocks",
    "layers",
    "owner_answer_policy",
    "arms",
    "normalization",
    "contamination",
    "treatment_authoring",
    "sensitivity",
    "contract_assets",
    "restrictions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(H|P)[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stratum": {
      "enum": [
        "historical_regression",
        "prospective_pilot",
        "prospective_holdout"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "sealed",
        "retired"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "cutoff_policy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "historical_unit",
            "prospective_brief"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_policy": {
          "enum": [
            "before_first_target_trace",
            "sealed_at_brief_freeze"
          ]
        }
      }
    },
    "brief_ref": {
      "$ref": "#/$defs/relativePath"
    },
    "artifact_contract": {
      "enum": [
        "single_unit",
        "portfolio"
      ]
    },
    "terminal_mode": {
      "enum": [
        "gate2_complete",
        "owner_review_ready_package"
      ]
    },
    "source_root_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]+$"
      }
    },
    "clocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "knowledge",
        "documentation",
        "workflow",
        "user",
        "model_tool"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/productClock"
        },
        "knowledge": {
          "$ref": "#/$defs/knowledgeClock"
        },
        "documentation": {
          "$ref": "#/$defs/documentationClock"
        },
        "workflow": {
          "$ref": "#/$defs/workflowClock"
        },
        "user": {
          "$ref": "#/$defs/userClock"
        },
        "model_tool": {
          "$ref": "#/$defs/modelToolClock"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_world",
        "documentation_world",
        "common_compatibility",
        "arm_bundle",
        "private_controls"
      ],
      "properties": {
        "product_world": {
          "$ref": "#/$defs/manifestRef"
        },
        "documentation_world": {
          "$ref": "#/$defs/manifestRef"
        },
        "common_compatibility": {
          "$ref": "#/$defs/manifestRef"
        },
        "arm_bundle": {
          "$ref": "#/$defs/manifestRef"
        },
        "private_controls": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "owner_answer_policy": {
      "$ref": "#/$defs/manifestRef"
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "A_USER",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/armA"
        },
        "A_USER": {
          "$ref": "#/$defs/armAUser"
        },
        "B": {
          "$ref": "#/$defs/armB"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "task_blind",
        "authority_map_ref"
      ],
      "properties": {
        "level": {
          "enum": [
            "N0",
            "N1"
          ]
        },
        "task_blind": {
          "const": true
        },
        "authority_map_ref": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "lineage_ref",
        "oracle_lineage"
      ],
      "properties": {
        "level": {
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3"
          ]
        },
        "lineage_ref": {
          "$ref": "#/$defs/relativePath"
        },
        "oracle_lineage": {
          "enum": [
            "historical_target_derived_private",
            "prospective_pre_output"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "treatment_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "clean_holdout_eligible",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "historical_posthoc",
            "pre_treatment_freeze_visible",
            "post_treatment_freeze_blind"
          ]
        },
        "clean_holdout_eligible": {
          "type": "boolean"
        },
        "evidence_ref": {
          "$ref": "#/$defs/relativePath"
        },
        "authoring_freeze_sha256": {
          "type": "string",
          "pattern": "^(?:pending|[a-f0-9]{64})$"
        },
        "case_authored_at": {
          "type": "string",
          "minLength": 1
        },
        "case_authored_commit": {
          "type": "string",
          "pattern": "^(?:pending|[a-f0-9]{40})$"
        },
        "authored_assets_manifest_sha256": {
          "type": "string",
          "pattern": "^(?:pending|[a-f0-9]{64})$"
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_vs_dp1"
      ],
      "properties": {
        "raw_vs_dp1": {
          "type": "boolean"
        }
      }
    },
    "contract_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "brief",
        "authority_map",
        "decision_inventory",
        "rubric",
        "provenance",
        "leak_signatures"
      ],
      "properties": {
        "case": {
          "const": "case.json"
        },
        "brief": {
          "const": "public/brief.md"
        },
        "authority_map": {
          "const": "knowledge/authority-map.json"
        },
        "decision_inventory": {
          "const": "judge-private/decision-inventory.json"
        },
        "rubric": {
          "const": "judge-private/rubric.md"
        },
        "provenance": {
          "const": "audit/provenance.md"
        },
        "leak_signatures": {
          "const": "audit/leak-signatures.txt"
        }
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "real_push",
        "host_memory",
        "parent_repo_access",
        "candidate_export_excludes"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "real_push": {
          "const": false
        },
        "host_memory": {
          "const": false
        },
        "parent_repo_access": {
          "const": false
        },
        "candidate_export_excludes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "allOf": [
            {
              "contains": {
                "const": "case.json"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "knowledge"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "judge-private"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "audit"
              },
              "minContains": 1
            }
          ]
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stratum": {
            "const": "historical_regression"
          }
        },
        "required": [
          "stratum"
        ]
      },
      "then": {
        "properties": {
          "origin": {
            "properties": {
              "kind": {
                "const": "historical_unit"
              },
              "cutoff_policy": {
                "const": "before_first_target_trace"
              }
            }
          },
          "clocks": {
            "properties": {
              "product": {
                "properties": {
                  "mode": {
                    "const": "historical_pre_target"
                  }
                }
              },
              "knowledge": {
                "properties": {
                  "mode": {
                    "const": "historical_cutoff"
                  }
                }
              }
            }
          },
          "contamination": {
            "properties": {
              "oracle_lineage": {
                "const": "historical_target_derived_private"
              }
            }
          },
          "treatment_authoring": {
            "properties": {
              "status": {
                "const": "historical_posthoc"
              },
              "clean_holdout_eligible": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stratum": {
            "const": "prospective_pilot"
          }
        },
        "required": [
          "stratum"
        ]
      },
      "then": {
        "properties": {
          "origin": {
            "properties": {
              "kind": {
                "const": "prospective_brief"
              },
              "cutoff_policy": {
                "const": "sealed_at_brief_freeze"
              }
            }
          },
          "clocks": {
            "properties": {
              "product": {
                "properties": {
                  "mode": {
                    "const": "prospective_sealed"
                  }
                }
              },
              "knowledge": {
                "properties": {
                  "mode": {
                    "const": "prospective_sealed"
                  }
                }
              }
            }
          },
          "contamination": {
            "properties": {
              "oracle_lineage": {
                "const": "prospective_pre_output"
              }
            }
          },
          "treatment_authoring": {
            "properties": {
              "status": {
                "const": "pre_treatment_freeze_visible"
              },
              "clean_holdout_eligible": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stratum": {
            "const": "prospective_holdout"
          }
        },
        "required": [
          "stratum"
        ]
      },
      "then": {
        "properties": {
          "origin": {
            "properties": {
              "kind": {
                "const": "prospective_brief"
              },
              "cutoff_policy": {
                "const": "sealed_at_brief_freeze"
              }
            }
          },
          "clocks": {
            "properties": {
              "product": {
                "properties": {
                  "mode": {
                    "const": "prospective_sealed"
                  }
                }
              },
              "knowledge": {
                "properties": {
                  "mode": {
                    "const": "prospective_sealed"
                  }
                }
              }
            }
          },
          "contamination": {
            "properties": {
              "level": {
                "const": "C0"
              },
              "oracle_lineage": {
                "const": "prospective_pre_output"
              }
            }
          },
          "treatment_authoring": {
            "required": [
              "authoring_freeze_sha256",
              "case_authored_at",
              "case_authored_commit",
              "authored_assets_manifest_sha256"
            ],
            "properties": {
              "status": {
                "const": "post_treatment_freeze_blind"
              },
              "clean_holdout_eligible": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "sealed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "budgets"
        ],
        "properties": {
          "owner_answer_policy": {"$ref": "#/$defs/frozenManifestRef"},
          "layers": {
            "properties": {
              "product_world": {"$ref": "#/$defs/frozenManifestRef"},
              "documentation_world": {"$ref": "#/$defs/frozenManifestRef"},
              "common_compatibility": {"$ref": "#/$defs/frozenManifestRef"},
              "arm_bundle": {"$ref": "#/$defs/frozenManifestRef"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_contract": {"const": "single_unit"}
        },
        "required": ["artifact_contract"]
      },
      "then": {
        "properties": {
          "terminal_mode": {"const": "gate2_complete"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_contract": {"const": "portfolio"}
        },
        "required": ["artifact_contract"]
      },
      "then": {
        "properties": {
          "terminal_mode": {
            "enum": ["gate2_complete", "owner_review_ready_package"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_mode": {"const": "owner_review_ready_package"}
        },
        "required": ["terminal_mode"]
      },
      "then": {
        "properties": {
          "artifact_contract": {"const": "portfolio"}
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "manifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "sha256"],
      "properties": {
        "manifest_ref": {"$ref": "#/$defs/relativePath"},
        "sha256": {
          "type": "string",
          "pattern": "^(?:pending|[a-f0-9]{64})$"
        }
      }
    },
    "frozenManifestRef": {
      "allOf": [
        {"$ref": "#/$defs/manifestRef"},
        {
          "properties": {
            "sha256": {"pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "clockBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ref"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "productClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "historical_pre_target",
                "prospective_sealed"
              ]
            }
          }
        }
      ]
    },
    "knowledgeClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "historical_cutoff",
                "prospective_sealed"
              ]
            }
          }
        }
      ]
    },
    "documentationClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "const": "suite_frozen_latest"
            }
          }
        }
      ]
    },
    "workflowClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "const": "current_frozen"
            }
          }
        }
      ]
    },
    "userClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "const": "current_cross_fitted"
            }
          }
        }
      ]
    },
    "modelToolClock": {
      "allOf": [
        {
          "$ref": "#/$defs/clockBase"
        },
        {
          "properties": {
            "mode": {
              "const": "current_frozen"
            }
          }
        }
      ]
    },
    "armBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "user_profile",
        "bundle_ref"
      ],
      "properties": {
        "workflow": {
          "type": "string"
        },
        "user_profile": {
          "type": "string"
        },
        "bundle_ref": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "armA": {
      "allOf": [
        {
          "$ref": "#/$defs/armBase"
        },
        {
          "properties": {
            "workflow": {
              "const": "current_spec_design_skills"
            },
            "user_profile": {
              "const": "none"
            }
          }
        }
      ]
    },
    "armAUser": {
      "allOf": [
        {
          "$ref": "#/$defs/armBase"
        },
        {
          "properties": {
            "workflow": {
              "const": "current_spec_design_skills"
            },
            "user_profile": {
              "const": "current_cross_fitted"
            }
          }
        }
      ]
    },
    "armB": {
      "allOf": [
        {
          "$ref": "#/$defs/armBase"
        },
        {
          "properties": {
            "workflow": {
              "const": "spec_design_agent_team"
            },
            "user_profile": {
              "const": "current_cross_fitted"
            }
          }
        }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_minutes",
        "max_model_calls",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "wall_time_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
