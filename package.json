{
  "name": "nano-multiagent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "check:ios-runtime": "tsx scripts/generate-ios-interactive.ts --check && tsc -p src/IM/ios/Runtime/tsconfig.json",
    "build": "pnpm -r --if-present build && node scripts/build-node-release.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p evals/memory/tsconfig.json",
    "pa": "node apps/node/lib/cli.js",
    "im": "node apps/im-server/lib/main.js",
    "memory-eval": "tsx evals/memory/cli.ts"
  },
  "devDependencies": {
    "@openuidev/lang-core": "1.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.5",
    "@nano/dsh-integration": "workspace:*",
    "@nano/product-contracts": "workspace:*",
    "@nano/personal-assistant": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1"
  }
}
