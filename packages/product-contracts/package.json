{
  "name": "@nano/product-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./capabilities": {
      "types": "./lib/capabilities.d.ts",
      "default": "./lib/capabilities.js"
    },
    "./trajectory-wire": {
      "types": "./lib/trajectory-wire.d.ts",
      "default": "./lib/trajectory-wire.js"
    },
    "./agent-lifecycle": {
      "types": "./lib/agent-lifecycle.d.ts",
      "default": "./lib/agent-lifecycle.js"
    },
    "./work-detail-worker": {
      "types": "./lib/work-detail-worker.d.ts",
      "default": "./lib/work-detail-worker.js"
    },
    "./serialization": {
      "types": "./lib/serialization.d.ts",
      "default": "./lib/serialization.js"
    },
    "./interactive-functions": {
      "types": "./lib/interactive-functions/index.d.ts",
      "default": "./lib/interactive-functions/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.1",
    "zod": "4.6.5"
  }
}
