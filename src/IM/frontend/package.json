{
  "name": "im-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node -e \"const { spawnSync } = require('node:child_process'); const args = process.argv.slice(1).filter((arg) => arg !== '--runInBand'); const result = spawnSync('vitest', ['run', ...args], { stdio: 'inherit', shell: true }); process.exit(result.status ?? 1);\" --",
    "test:watch": "vitest"
  },
