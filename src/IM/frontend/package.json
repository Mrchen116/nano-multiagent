{
  "name": "im-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node -e \"const { spawnSync } = require('node:child_process'); const args = process.argv.slice(1).filter((arg) => arg !== '--runInBand'); const result = spawnSync('vitest', ['run', ...args], { stdio: 'inherit', shell: true }); process.exit(result.status ?? 1);\" --",
    "test:watch": "vitest",
    "check:interactive-assets": "tsx ../../../scripts/generate-interactive-ui.ts --check",
    "pretest": "npm run check:interactive-assets"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@nano/product-contracts": "file:../../../packages/product-contracts",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.5",
    "clsx": "^2.1.1",
    "i18next": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^27.0.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.12",
    "tsx": "4.22.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@openuidev/react-ui": {
      "zustand": "$zustand"
    },
    "@openuidev/react-headless": {
      "zustand": "$zustand"
    }
  }
}
